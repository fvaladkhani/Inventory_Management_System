# Dependencies
/backend/vendor/
/frontend/node_modules/

# Environment files
/backend/.env
/backend/.env.backup

# Database
/backend/database/*.sqlite

# Cache and logs
/backend/storage/*.key
/backend/storage/logs/*.log
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*.php

# Frontend build output (regenerate via `npm run build`, see INSTALL.md)
/frontend/build/

# Backend public folder — built frontend assets copied in during deploy
# (keep .htaccess and index.php, which are source-controlled)
/backend/public/static/
/backend/public/index.html
/backend/public/asset-manifest.json
/backend/public/locales/
/backend/public/fonts/

# OS files
.DS_Store
Thumbs.db
.idea/
.vscode/